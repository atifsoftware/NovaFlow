# Disable directory browsing
Options -Indexes
Options -MultiViews

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /NovaFlow/

    # Direct access to public folder bypasses rewriting
    RewriteCond %{REQUEST_URI} ^/NovaFlow/public/ [NC]
    RewriteRule ^ - [L]

    # Rewrite empty root or any path into public
    RewriteRule ^$ public/ [L]
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
