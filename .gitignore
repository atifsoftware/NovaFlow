# NovaFlow — GitHub Gitignore Template
/vendor/
node_modules/
.env
.env.backup
composer.lock
composer.phar
*.log
/logs/*
!/logs/.gitkeep
.idea/
.vscode/
*.code-workspace
.DS_Store
.phpunit.cache/
/storage/cache/*
!/storage/cache/.gitkeep
/storage/queue/*
!/storage/queue/.gitkeep
/storage/logs/*
!/storage/logs/.gitkeep
/public/uploads/*
!/public/uploads/.htaccess
!/public/uploads/.gitkeep

