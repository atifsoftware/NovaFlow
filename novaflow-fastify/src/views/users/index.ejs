<div class="card">
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
    <div>
      <h2 style="font-size: 1.5rem; font-weight: 700; color: #ffffff;">Users Management (MVC Controller)</h2>
      <p style="color: #94a3b8; font-size: 0.85rem;">Rendered by <code>UserController@index</code> using <code>User::all()</code> Active Record Model.</p>
    </div>
  </div>

  <table>
    <thead>
      <tr>
        <th>ID</th>
        <th>Name</th>
        <th>Email</th>
        <th>Role</th>
        <th>Status</th>
        <th>Created At</th>
      </tr>
    </thead>
    <tbody>
      <% users.forEach(function(u) { %>
        <tr>
          <td style="font-family: monospace; color: #64748b;">#<%= u.id %></td>
          <td style="font-weight: 600; color: #ffffff;"><%= u.name %></td>
          <td style="font-family: monospace; color: #94a3b8;"><%= u.email %></td>
          <td><span style="font-size: 0.75rem; text-transform: uppercase; font-weight: 700; color: #38bdf8;"><%= u.role %></span></td>
          <td>
            <span class="badge <%= u.status === 'active' ? 'badge-success' : 'badge-danger' %>">
              <%= u.status %>
            </span>
          </td>
          <td style="font-family: monospace; font-size: 0.75rem; color: #64748b;"><%= u.createdAt %></td>
        </tr>
      <% }); %>
    </tbody>
  </table>
</div>
