<div class="card">
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
    <div>
      <span style="font-size: 0.75rem; font-family: monospace; color: #38bdf8; text-transform: uppercase;">Module: Sales (HMVC)</span>
      <h2 style="font-size: 1.5rem; font-weight: 700; color: #ffffff;">Invoices & Billings</h2>
      <p style="color: #94a3b8; font-size: 0.85rem;">Managed by <code>InvoiceController@index</code> inside <code>src/modules/sales/</code></p>
    </div>
  </div>

  <table>
    <thead>
      <tr>
        <th>Invoice #</th>
        <th>Customer</th>
        <th>Amount</th>
        <th>Status</th>
        <th>Issue Date</th>
      </tr>
    </thead>
    <tbody>
      <% invoices.forEach(function(inv) { %>
        <tr>
          <td style="font-family: monospace; font-weight: 600; color: #ffffff;"><%= inv.invoiceNumber %></td>
          <td style="color: #cbd5e1;"><%= inv.customer %></td>
          <td style="font-family: monospace; font-weight: 700; color: #10b981;">$<%= inv.amount.toFixed(2) %></td>
          <td>
            <span class="badge <%= inv.status === 'paid' ? 'badge-success' : 'badge-danger' %>">
              <%= inv.status %>
            </span>
          </td>
          <td style="font-family: monospace; font-size: 0.75rem; color: #64748b;"><%= inv.date %></td>
        </tr>
      <% }); %>
    </tbody>
  </table>
</div>
