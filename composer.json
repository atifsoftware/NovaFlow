{
    "name": "atifsoftware/novaflow",
    "description": "Ultra-fast, enterprise-grade PHP 8.2 MVC framework with Multi-DB Grammars, Transactions, S3 Storage, and Queue architecture",
    "version": "2.1.0",
    "type": "project",
    "keywords": [
        "php",
        "framework",
        "mvc",
        "novaflow",
        "speed",
        "transactions",
        "s3-storage",
        "queue-worker"
    ],
    "license": "MIT",
    "homepage": "https://github.com/atifsoftware/NovaFlow",
    "authors": [
        {
            "name": "Mohidul Hasan",
            "email": "shohaghinfo@gmail.com",
            "homepage": "https://github.com/atifsoftware"
        }
    ],
    "support": {
        "email": "shohaghinfo@gmail.com",
        "issues": "https://github.com/atifsoftware/NovaFlow/issues",
        "source": "https://github.com/atifsoftware/NovaFlow"
    },
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "NovaFlow\\Core\\": "app/libraries/",
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    }
}

