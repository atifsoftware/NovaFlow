APP_NAME=NovaFlow
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost/NovaFlow

# ==============================================================================
# DATABASE CONFIGURATION (ডাটাবেজ কনফিগারেশন)
# ==============================================================================
# Supported Drivers / Connections (সমর্থিত ডাটাবেজসমূহ):
# 1. mysql  - MySQL & MariaDB
# 2. pgsql  - PostgreSQL
# 3. sqlite - SQLite 3
# ==============================================================================

# --- [Option 1: MySQL / MariaDB (Default)] ---
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=novaflow_db
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# --- [Option 2: PostgreSQL] ---
# DB_CONNECTION=pgsql
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=novaflow_pg
# DB_USER=postgres
# DB_PASS=secret

# --- [Option 3: SQLite] ---
# DB_CONNECTION=sqlite
# DB_NAME=storage/database.sqlite
# (Or in-memory: DB_NAME=:memory:)

SESSION_DRIVER=file
CACHE_DRIVER=file

# ==============================================================================
# FILESYSTEM / STORAGE CONFIGURATION (ফাইল ও ক্লাউড স্টোরেজ)
# ==============================================================================
# Supported: local, s3
FILESYSTEM_DISK=local

# AWS S3 / Cloudflare R2 / MinIO (Needed if FILESYSTEM_DISK=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=

# ==============================================================================
# QUEUE CONFIGURATION (ব্যাকগ্রাউন্ড কিউ সিস্টেম)
# ==============================================================================
# Supported: sync, file, database, redis
QUEUE_CONNECTION=sync

# Redis (Needed if QUEUE_CONNECTION=redis or CACHE_DRIVER=redis)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
