# NovaFlow Upload Security
# Block all script execution in uploads directory
<FilesMatch ".*">
    SetHandler None
</FilesMatch>

# Disable PHP execution
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

# Disable CGI execution
Options -ExecCGI -Indexes
